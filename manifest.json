{
  "manifest_version": 3,
  "name": "Netflix Intro Skipper",
  "version": "1.0.0",
  "description": "Automatically skip Netflix intros for seamless viewing experience",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.netflix.ca/*",
    "*://*.netflix.co.uk/*",
    "*://*.netflix.de/*",
    "*://*.netflix.fr/*",
    "*://*.netflix.it/*",
    "*://*.netflix.es/*",
    "*://*.netflix.nl/*",
    "*://*.netflix.be/*",
    "*://*.netflix.ch/*",
    "*://*.netflix.at/*",
    "*://*.netflix.se/*",
    "*://*.netflix.no/*",
    "*://*.netflix.dk/*",
    "*://*.netflix.fi/*",
    "*://*.netflix.pl/*",
    "*://*.netflix.cz/*",
    "*://*.netflix.hu/*",
    "*://*.netflix.ro/*",
    "*://*.netflix.bg/*",
    "*://*.netflix.hr/*",
    "*://*.netflix.si/*",
    "*://*.netflix.sk/*",
    "*://*.netflix.lt/*",
    "*://*.netflix.lv/*",
    "*://*.netflix.ee/*",
    "*://*.netflix.ie/*",
    "*://*.netflix.pt/*",
    "*://*.netflix.gr/*",
    "*://*.netflix.co.jp/*",
    "*://*.netflix.co.kr/*",
    "*://*.netflix.com.au/*",
    "*://*.netflix.co.nz/*",
    "*://*.netflix.com.sg/*",
    "*://*.netflix.com.my/*",
    "*://*.netflix.co.th/*",
    "*://*.netflix.com.ph/*",
    "*://*.netflix.co.id/*",
    "*://*.netflix.com.vn/*",
    "*://*.netflix.com.tw/*",
    "*://*.netflix.com.hk/*",
    "*://*.netflix.co.in/*",
    "*://*.netflix.com.mx/*",
    "*://*.netflix.com.br/*",
    "*://*.netflix.com.ar/*",
    "*://*.netflix.cl/*",
    "*://*.netflix.com.co/*",
    "*://*.netflix.com.pe/*",
    "*://*.netflix.com.tr/*",
    "*://*.netflix.co.il/*",
    "*://*.netflix.co.za/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.netflix.ca/*",
        "*://*.netflix.co.uk/*",
        "*://*.netflix.de/*",
        "*://*.netflix.fr/*",
        "*://*.netflix.it/*",
        "*://*.netflix.es/*",
        "*://*.netflix.nl/*",
        "*://*.netflix.be/*",
        "*://*.netflix.ch/*",
        "*://*.netflix.at/*",
        "*://*.netflix.se/*",
        "*://*.netflix.no/*",
        "*://*.netflix.dk/*",
        "*://*.netflix.fi/*",
        "*://*.netflix.pl/*",
        "*://*.netflix.cz/*",
        "*://*.netflix.hu/*",
        "*://*.netflix.ro/*",
        "*://*.netflix.bg/*",
        "*://*.netflix.hr/*",
        "*://*.netflix.si/*",
        "*://*.netflix.sk/*",
        "*://*.netflix.lt/*",
        "*://*.netflix.lv/*",
        "*://*.netflix.ee/*",
        "*://*.netflix.ie/*",
        "*://*.netflix.pt/*",
        "*://*.netflix.gr/*",
        "*://*.netflix.co.jp/*",
        "*://*.netflix.co.kr/*",
        "*://*.netflix.com.au/*",
        "*://*.netflix.co.nz/*",
        "*://*.netflix.com.sg/*",
        "*://*.netflix.com.my/*",
        "*://*.netflix.co.th/*",
        "*://*.netflix.com.ph/*",
        "*://*.netflix.co.id/*",
        "*://*.netflix.com.vn/*",
        "*://*.netflix.com.tw/*",
        "*://*.netflix.com.hk/*",
        "*://*.netflix.co.in/*",
        "*://*.netflix.com.mx/*",
        "*://*.netflix.com.br/*",
        "*://*.netflix.com.ar/*",
        "*://*.netflix.cl/*",
        "*://*.netflix.com.co/*",
        "*://*.netflix.com.pe/*",
        "*://*.netflix.com.tr/*",
        "*://*.netflix.co.il/*",
        "*://*.netflix.co.za/*"
      ],
      "js": [
        "src/settings.js",
        "src/integration.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Netflix Intro Skipper Settings",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  }
}
