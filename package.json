{
  "name": "netflix-intro-skipper",
  "version": "1.0.2",
  "description": "Chrome extension to automatically skip Netflix intros for seamless viewing experience",
  "main": "manifest.json",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "version:patch": "node scripts/release-version.js check && npm version patch --no-git-tag-version && node scripts/release-version.js sync",
    "version:minor": "node scripts/release-version.js check && npm version minor --no-git-tag-version && node scripts/release-version.js sync",
    "version:major": "node scripts/release-version.js check && npm version major --no-git-tag-version && node scripts/release-version.js sync",
    "version:dry-run:patch": "node scripts/release-version.js dry-run patch",
    "version:dry-run:minor": "node scripts/release-version.js dry-run minor",
    "version:dry-run:major": "node scripts/release-version.js dry-run major",
    "preversion": "npm test"
  },
  "keywords": [
    "netflix",
    "chrome-extension",
    "intro-skipper",
    "automation",
    "streaming",
    "javascript",
    "manifest-v3"
  ],
  "author": "yowatanabe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yowatanabe/netflix-intro-skipper.git"
  },
  "bugs": {
    "url": "https://github.com/yowatanabe/netflix-intro-skipper/issues"
  },
  "homepage": "https://github.com/yowatanabe/netflix-intro-skipper#readme",
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/test-setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!tests/**",
      "!node_modules/**"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js",
      "<rootDir>/**/*.test.js"
    ]
  }
}
